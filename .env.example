# =====================================================================
# AI Trader - example environment configuration.
# Copy to .env and fill in your own credentials:  copy .env.example .env
# =====================================================================

# --- Alpaca (paper trading) ---
# Get free paper keys at https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex

# --- LLM (none = pure quant engine) ---
LLM_PROVIDER=none
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Server ---
HOST=127.0.0.1
PORT=8000
START_BOT_ON_LAUNCH=true
SCAN_INTERVAL_SEC=30

# --- Engine ---
REGIME_METHOD=hybrid
TAPE_ENABLED=true
FLATTEN_ON_STOP=false
RISK_PROFILE=balanced

# --- Data integrity: 0 fake data policy ---
# When true the app never substitutes synthetic (random-walk) prices for real
# Alpaca data. If the live feed drops it surfaces an error and retries instead
# of showing made-up numbers. Synthetic data is only used with no keys at all.
REAL_DATA_ONLY=true

# --- Elite day-trader playbook (selectivity gate) ---
ELITE_ENABLED=true
ELITE_MIN_SCORE=0.45
ELITE_REQUIRE_TREND=true
ELITE_SESSION_FILTER=true
ELITE_MIN_RVOL=0.8
ELITE_MARKET_VETO=false

# --- Flexible (human-style) stop management ---
# Patience first: a fresh trade is given a lot of room and the tight structural
# stop is suspended for a long grace period (only the wide disaster backstop is
# live). We exit when the trade is genuinely wrong, not on ordinary noise.
# There is deliberately NO stall exit: a position is held until its thesis
# breaks, not until a clock runs out.
STOP_GRACE_MIN=45
DISASTER_STOP_PCT=0.035
MAX_HOLD_MIN=360
REVENGE_COOLDOWN_MIN=45
STOP_GRACE_MULT=1.6

# --- Patience / let-it-run profit management ---
# Move the stop to break-even only after this many R; never trim a winner unless
# SCALE_OUT_R > 0; flatten everything just before the close (intraday desk).
BREAKEVEN_R=1.5
SCALE_OUT_R=0.0
SCALE_OUT_FRAC=0.25
FLATTEN_AT_EOD=true

# --- Signal quality: require confluence, refuse to fade a trend ---
MIN_CONFLUENCE=2
ANTIFADE_ENABLED=true

# --- Portfolio heat guard (sum of open $ risk as a fraction of equity) ---
MAX_OPEN_HEAT_PCT=0.06

# --- Watchlist (the traded universe; keep names liquid) ---
WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AMD,AVGO,NFLX,CRM,ADBE,ORCL,INTC,QCOM,MU,AMAT,LRCX,PLTR,COIN,UBER,SHOP,SNOW,PANW,NOW,ARM,SMCI,MSTR,CRWD,DDOG,ZS,NET,HOOD,SOFI,PYPL,MARA,RIOT,CLSK,NIO,RIVN,LCID,F,GM,ABNB,DKNG,DIS,XOM,CVX,LLY,SPY,QQQ,IWM,SMH,SOXL,TQQQ,ARKK,XLE,XLF

# --- Watchdog / notifications (optional) ---
# NOTIFY_WEBHOOK_URL=
# NOTIFY_KIND=auto
# NOTIFY_TELEGRAM_CHAT=
